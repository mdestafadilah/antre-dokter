# ──────────────────────────────────────────────
# Docker Environment Variables - antre-dokter
# Salin file ini menjadi .env lalu sesuaikan
# ──────────────────────────────────────────────

# Database
DB_NAME=antre_dokter
DB_USER=postgres
DB_PASSWORD=ganti_password_aman_ini

# Server
NODE_ENV=production
PORT=3000
JWT_SECRET=ganti_dengan_secret_key_yang_panjang_dan_acak
JWT_EXPIRE=24h

# CORS - URL frontend yang diizinkan mengakses API
CORS_ORIGIN=http://localhost:5173

# Client
VITE_API_URL=http://localhost:3000/api
